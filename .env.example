NEXT_PUBLIC_SITE_URL=

# Prisma Postgres: pooled for app queries, direct for Prisma CLI migrations/admin.
DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
DIRECT_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# One-time import source retained locally; do not use this for deployed app storage.
LEGACY_SQLITE_PATH=data/site.sqlite
MEDIA_PATH=data/media
BACKUP_PATH=backups
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ZeptoMail handles transactional email. Newsletter subscribers are stored in
# PostgreSQL and can be exported from the admin workspace for campaign sending.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=

# Optional Paystack checkout and webhook verification
PAYSTACK_SECRET_KEY=
